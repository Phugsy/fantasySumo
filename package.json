{
  "name": "fantasy-sumo",
  "version": "0.0.0",
  "private": true,
  "description": "Fantasy Sumo web app foundation.",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "pnpm --filter @fantasy-sumo/domain build && concurrently -n api,web -c blue,green \"pnpm --filter @fantasy-sumo/api dev\" \"pnpm --filter @fantasy-sumo/web dev\"",
    "build": "pnpm -r --if-present build",
    "test": "pnpm --filter @fantasy-sumo/domain build && pnpm -r --if-present test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phugsy/fantasySumo.git"
  },
  "author": "James Carr",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Phugsy/fantasySumo/issues"
  },
  "homepage": "https://github.com/Phugsy/fantasySumo#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
